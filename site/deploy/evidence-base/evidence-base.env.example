# Settings of the evidence-base service. Copy to /etc/evidence-base/evidence-base.env and edit.
# One KEY=value per line, no quotes. No secret is needed for anything here.

# Where the Cargo Passport checkout is (it holds tools/, data/ and research/).
EVIDENCE_REPO_DIR=/opt/cargo-passport
# The evidence base: the pipeline creates it and keeps it as its own git repository.
EVIDENCE_BASE_DIR=/var/lib/evidence-base
# The gbrain program. The gbrain command starts with "#!/usr/bin/env bun", and a systemd service gets only a short
# default PATH, so PATH below must also hold the directory of bun (and of git and pdftotext, normally /usr/bin).
GBRAIN_BIN=/home/gbrain/.bun/bin/gbrain
PATH=/home/gbrain/.bun/bin:/usr/local/bin:/usr/bin:/bin
# gbrain keeps its brain under the home of the user that owns it. Run the service as that user.
HOME=/home/gbrain

# The author of the base's own git commits.
EVIDENCE_GIT_NAME=Evidence Base
EVIDENCE_GIT_EMAIL=evidence-base@localhost

# Optional. Defaults are shown.
# EVIDENCE_OTHER_TEXT=full
# EVIDENCE_PAGE_TYPE=source
# EVIDENCE_HOST_PAUSE_MS=1500
# NODE_USE_ENV_PROXY=1
