# Pooled connection for the app; direct (non-pooler) connection for Alembic migrations.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/cargo_passport?sslmode=require
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@HOST.REGION.aws.neon.tech/cargo_passport?sslmode=require
# Eustella AI (OpenAI-compatible). Server-side only; never ship to the browser.
# EUSTELLA_API_KEY / EUSTELLA_BASE_URL / EUSTELLA_MODEL work too. Only the key is required.
SI_API_KEY=rk_your_key_here
# SI_BASE_URL=https://api.eustella.com/v1
# SI_MODEL=eustella-v1.5
# Comma-separated browser origins allowed to call the API (add the GitHub Pages origin).
CORS_ORIGINS=http://localhost:8000
